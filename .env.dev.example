# ─────────────────────────────────────────────────────────────
# GLADOS TERMINAL local development environment template
#
# Copy this file to .env.dev and adjust as needed. Used by the
# Poetry/uvicorn dev loop (ENV_FILE=.env.dev poetry run uvicorn
# src.main:app --reload --port 8600), NOT by docker-compose.yml (that
# reads plain .env, see .env.example). See docs/DEVELOPMENT.md.
# ─────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ── Bridge ─────────────────────────────────────────────────────────────
# 127.0.0.1 is the default even without this line -- stated explicitly
# here as a reminder that a bare host run must never bind anywhere else.
BRIDGE__HOST=127.0.0.1
BRIDGE__PORT=8600
# The Vite dev server serving glados-frontend. Both spellings are listed
# because http://localhost:5173 and http://127.0.0.1:5173 are distinct
# origins to a browser, and which one you get depends on how you opened
# the page. Comma-separated, no JSON array.
BRIDGE__ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Identity ───────────────────────────────────────────────────────────
# A repo-local state directory (gitignored) instead of the device's
# /var/lib/glados-terminal. Delete it to get a fresh device identity.
IDENTITY__STATE_DIR=.state
# Paste a terminal key from your local Glados (Settings, API keys,
# "Create terminal key"), or leave empty.
IDENTITY__API_KEY=

# ── Devices ────────────────────────────────────────────────────────────
# No hardware on a dev machine: use the mock device plus POST
# /debug/simulate (mounted because DEBUG=true above) to exercise the
# whole event path from a frontend dev server.
MOCK__ENABLED=true
RFID__ENABLED=false
SCANNER__ENABLED=false
