# ─────────────────────────────────────────────────────────────
# GLADOS TERMINAL device environment template
#
# Copy this file to .env on the device (cp .env.example .env), fill in
# real values, then `docker compose pull && docker compose up -d`. See
# docs/INSTALLATION.md for the full provisioning walkthrough.
# ─────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────
# Disables debug mode; must be false on a deployed device -- DEBUG=true
# mounts POST /debug/simulate, see CLAUDE.md's hard rules.
DEBUG=false
# Minimum level written to stdout: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
# Stdout log line format: "text" for humans, "json" for a log aggregator.
LOG_FORMAT=text

# ── Bridge ─────────────────────────────────────────────────────────────
# BRIDGE__HOST is set to 0.0.0.0 by docker-compose.yml's `environment:`
# block, not here -- inside the bridge container that is what lets the
# 127.0.0.1-only port mapping reach it. Never set BRIDGE__HOST=0.0.0.0
# for a bare (non-Docker) run; see docs/DEVELOPMENT.md.
BRIDGE__PORT=8600
# Browser origins allowed to read /health and /devices and to open
# /ws/events. Comma-separated, no JSON array. This is the ORIGIN of
# KIOSK_URL below (scheme + host + optional port, no path) -- keep the
# two in step, a mismatch shows up as a kiosk that renders but never
# receives a device event. Empty means no browser may reach the bridge.
BRIDGE__ALLOWED_ORIGINS=https://glados.example.com

# ── Identity ───────────────────────────────────────────────────────────
# The terminal key created in Glados under Settings, API keys, "Create
# terminal key". The bridge hands it, together with this device's
# generated public key, to the kiosk page through GET /identity and never
# checks it itself. Only an infoscreen needs it; leave it empty on a
# plain RFID or scanner terminal.
IDENTITY__API_KEY=
# IDENTITY__STATE_DIR is left at its default (/var/lib/glados-terminal),
# the named volume docker-compose.yml mounts there.

# ── System ─────────────────────────────────────────────────────────────
# SYSTEM__OS_RELEASE_PATH, SYSTEM__HOSTNAME_PATH and SYSTEM__SWAY_SOCKET_DIR
# are left at their defaults: the host files and the kiosk's runtime
# directory docker-compose.yml mounts into the bridge for GET /device and
# POST /display.

# ── Kiosk ──────────────────────────────────────────────────────────────
# The glados-frontend URL this device displays, e.g. the central
# server's HTTPS origin, or https://glados.example.com/infoscreen for a
# wall display. Required -- the kiosk container refuses to start
# without it.
KIOSK_URL=https://glados.example.com
# Optional passthrough for hardware-specific Chromium flags this compose
# setup should not have to guess at (e.g. GPU/ozone quirks on a given Pi
# revision). Leave unset unless a specific device needs it.
# KIOSK_EXTRA_FLAGS=
# Extra certificate authority Chromium trusts, for a Glados server whose
# certificate an internal CA issued. Leave it unset for a certificate from
# a public CA such as Let's Encrypt. The value is the CA certificate as
# base64 DER on one line, several separated by commas. From a PEM file:
#   openssl x509 -in ca.pem -outform der | base64 -w0
# KIOSK_CA_CERT=
# Display settings, applied to every connected display. Leave them unset
# to use the display's preferred mode, unrotated, at scale 1. Run
# `docker compose up -d kiosk` after changing them.
#   KIOSK_OUTPUT_MODE       resolution, optionally with refresh rate:
#                           1920x1080 or 1920x1080@60Hz
#   KIOSK_OUTPUT_TRANSFORM  rotation: normal, 90, 180 or 270 (clockwise);
#                           a touchscreen is rotated with it
#   KIOSK_OUTPUT_SCALE      UI scale, whole numbers only: 1 or 2. A fraction
#                           such as 1.5 is accepted but blurs the page. For
#                           any other scale (1.25, 0.75), leave it unset and
#                           set KIOSK_EXTRA_FLAGS=--force-device-scale-factor=1.25
#                           instead, which keeps the page sharp
# KIOSK_OUTPUT_MODE=1920x1080@60Hz
# KIOSK_OUTPUT_TRANSFORM=90
# KIOSK_OUTPUT_SCALE=1

# ── Images ─────────────────────────────────────────────────────────────
# Image tag docker-compose.yml pulls for both containers. Leave it unset:
# the default is the version of the checked-out release tag. Only a test
# kiosk sets it, to follow the `staging` branch or the release branch under
# review, see docs/RELEASING.md section 3.
# TERMINAL_VERSION=staging

# ── RFID reader (evdev) ──────────────────────────────────────────────────
RFID__ENABLED=false
# /dev/input/by-id/... path, stable across reboots (unlike /dev/input/eventN).
# See docs/INSTALLATION.md section 8 for how to find it.
RFID__DEVICE_PATH=/dev/input/by-id/change_me-rfid-reader

# ── QR/barcode scanner (serial) ───────────────────────────────────────────
SCANNER__ENABLED=false
# /dev/serial/by-id/... path, stable across reboots (unlike /dev/ttyUSBn).
# See docs/INSTALLATION.md section 8 for how to find it.
SCANNER__DEVICE_PATH=/dev/serial/by-id/change_me-scanner
SCANNER__BAUD_RATE=9600

# ── Mock device (development / demos only) ────────────────────────────────
# Never enable on a real deployment: it's a fake device with no hardware
# behind it, meant for frontend development and testing.
MOCK__ENABLED=false
